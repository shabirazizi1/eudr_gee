# Your Earth Engine-registered Google Cloud project ID
GEE_PROJECT=eudr-gee-513515

# true = never call Earth Engine (fake but deterministic results, for offline dev)
USE_MOCK_GEE=false

# If a real Earth Engine call fails, fall back to mock results (clearly labelled "mock" in the UI)
ALLOW_MOCK_FALLBACK=true

# Hansen Global Forest Change asset (update when a newer version is published)
HANSEN_ASSET=UMD/hansen/global_forest_change_2024_v1_12

# EUDR deforestation cutoff year (cutoff date = 31 Dec of this year)
CUTOFF_YEAR=2020
